# ULMS RDP configuration — copy to config.env and fill in.
#   cp config.env.example config.env && chmod 600 config.env
# config.env is git-ignored. It contains NO password: the password lives in the
# GNOME keyring (see the guide, Step 2).

# The ULMS Windows server address. Ask ULMS IT if you do not have it.
RDP_HOST=10.x.x.x

# Your Windows account name.
RDP_USER=your_windows_username

# Optional Active Directory domain. Leave blank for a bare username.
RDP_DOMAIN=

# Local folder shared into the Windows session.
RDP_SHARE_DIR=$HOME/rdp_share

# Name it appears under in Windows: \\tsclient\<RDP_SHARE_NAME>
RDP_SHARE_NAME=share

# FreeRDP binary: xfreerdp (FreeRDP 2) or xfreerdp3 (FreeRDP 3).
RDP_BIN=xfreerdp

# Optional HiDPI scaling: 100, 140 or 180. Blank disables scaling flags.
RDP_SCALE=

# Extra flags passed through verbatim, e.g. "/sec:tls /multimon"
RDP_EXTRA_FLAGS=
